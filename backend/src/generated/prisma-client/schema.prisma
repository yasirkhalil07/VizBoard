// VizBoard - Prisma Schema
// Database: SQLite (dev) → PostgreSQL (prod)

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma-client"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// ROLES
// ============================================================
model Role {
  id   Int    @id @default(autoincrement())
  name String @unique // "admin" | "client"

  users User[]

  @@map("roles")
}

// ============================================================
// USERS
// ============================================================
model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role_id  Int

  // Relations
  role             Role              @relation(fields: [role_id], references: [id])
  dashboards       Dashboard[]
  data_connections DataConnection[]
  files            File[]
  dashboard_access DashboardAccess[]
  refresh_tokens   RefreshToken[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

// ============================================================
// REFRESH TOKENS
// ============================================================
model RefreshToken {
  id      Int    @id @default(autoincrement())
  token   String @unique
  user_id Int
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  expires_at DateTime

  @@map("refresh_tokens")
}

// ============================================================
// DATA CONNECTIONS (MySQL / PostgreSQL)
// ============================================================
model DataConnection {
  id              Int    @id @default(autoincrement())
  connection_name String @unique
  user_id         Int
  db_type         String // "mysql" | "postgres"
  host            String
  username        String
  password        String
  database_name   String

  // Relations
  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chart_data_sources ChartDataSource[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("data_connections")
}

// ============================================================
// DASHBOARDS
// ============================================================
model Dashboard {
  id      Int    @id @default(autoincrement())
  name    String
  user_id Int

  // Relations
  user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tabs             Tab[]
  dashboard_access DashboardAccess[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("dashboards")
}

// ============================================================
// DASHBOARD ACCESS (M:M — Dashboard ↔ Users/Clients)
// ============================================================
model DashboardAccess {
  id           Int @id @default(autoincrement())
  dashboard_id Int
  user_id      Int

  // Relations
  dashboard Dashboard @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([dashboard_id, user_id]) // Prevent duplicate access entries
  @@map("dashboard_access")
}

// ============================================================
// TABS (Power BI style — belongs to Dashboard)
// ============================================================
model Tab {
  id           Int    @id @default(autoincrement())
  dashboard_id Int
  name         String
  order_index  Int    @default(0)

  // Relations
  dashboard Dashboard @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)
  charts    Chart[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("tabs")
}

// ============================================================
// CHARTS
// ============================================================
model Chart {
  id         Int    @id @default(autoincrement())
  tab_id     Int
  name       String
  chart_type String // "line" | "bar" | "pie"
  config     String // JSON stored as String (SQLite limitation)
  position_x Float  @default(0)
  position_y Float  @default(0)
  width      Float  @default(400)
  height     Float  @default(300)

  // Relations
  tab         Tab              @relation(fields: [tab_id], references: [id], onDelete: Cascade)
  data_source ChartDataSource?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("charts")
}

// ============================================================
// FILES (CSV / Excel uploads)
// ============================================================
model File {
  id        Int    @id @default(autoincrement())
  user_id   Int
  file_name String
  file_type String // "csv" | "xlsx"
  file_path String

  // Relations
  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chart_data_sources ChartDataSource[]

  created_at DateTime @default(now())

  @@map("files")
}

// ============================================================
// CHART DATA SOURCES (Polymorphic — File OR DB Connection)
// ============================================================
model ChartDataSource {
  id            Int    @id @default(autoincrement())
  chart_id      Int    @unique // 1:1 with Chart
  type          String // "file" | "db"
  file_id       Int? // nullable — used when type = "file"
  connection_id Int? // nullable — used when type = "db"

  // Relations
  chart      Chart           @relation(fields: [chart_id], references: [id], onDelete: Cascade)
  file       File?           @relation(fields: [file_id], references: [id], onDelete: SetNull)
  connection DataConnection? @relation(fields: [connection_id], references: [id], onDelete: SetNull)

  @@map("chart_data_sources")
}
